# Reverse proxy + automatic HTTPS (Let's Encrypt) for the web app.
# DOMAIN is injected via the compose `caddy` service environment.
{$DOMAIN} {
	encode zstd gzip

	# Match the app's large-upload path (ZIP/PDF ingest up to 256 MB).
	request_body {
		max_size 256MB
	}

	reverse_proxy web:3000 {
		# Keep transient container restarts from surfacing as a 502 to the browser.
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}
