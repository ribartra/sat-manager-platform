# Reverse proxy + automatic HTTPS (Let's Encrypt) for the web app.
# DOMAIN is injected via the compose `caddy` service environment.
{$DOMAIN} {
	encode zstd gzip

	# TLS 1.2+ only (Caddy's default, pinned so it cannot drift).
	tls {
		protocols tls1.2 tls1.3
	}

	# HSTS: browsers only ever reach the site over HTTPS for the next year.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Match the app's large-upload path (ZIP/PDF ingest up to 256 MB).
	request_body {
		max_size 256MB
	}

	# Internal service endpoints (cron jobs) are only reachable inside the VM.
	@internal path /api/internal/*
	respond @internal 404

	reverse_proxy web:3000 {
		# Keep transient container restarts from surfacing as a 502 to the browser.
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}
