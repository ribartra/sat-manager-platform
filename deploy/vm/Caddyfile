# Reverse proxy + automatic HTTPS (Let's Encrypt) for the web app.
# DOMAIN is injected via the compose `caddy` service environment.

{
	servers {
		timeouts {
			# Slow or stalled clients can't hold connections open forever (slowloris).
			read_header 15s
			# Long enough for a 256 MB import on a slow connection.
			read_body 10m
			idle 2m
			# No write timeout: PDF reports and promotions may take a while to answer.
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# TLS 1.2+ only (Caddy's default, pinned so it cannot drift).
	tls {
		protocols tls1.2 tls1.3
	}

	# HSTS: browsers only ever reach the site over HTTPS for the next year.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Uploads: only the import routes take large files (ZIP/PDF ingest up to 256 MB, same limits as
	# the routes). Everything else (avatars, question images, report screenshots, the import CSV)
	# is under 16 MB.
	@bulk_upload path /api/admin/ai-import/* /api/import/quick /api/import/quick/* /api/import/batches/*
	request_body @bulk_upload {
		max_size 256MiB
	}
	@regular_body not path /api/admin/ai-import/* /api/import/quick /api/import/quick/* /api/import/batches/*
	request_body @regular_body {
		max_size 16MiB
	}

	# Internal service endpoints (cron jobs) are only reachable inside the VM.
	@internal path /api/internal/*
	respond @internal 404

	reverse_proxy web:3000 {
		# Deploys and container restarts: hold requests (up to 30 s, the web start time) instead
		# of answering 502, so a deploy looks like a slow page, not an outage.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}
