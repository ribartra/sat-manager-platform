# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/backups
/.private

# local database/runtime state
/dev.db
*.db
*.db-journal
*.db-shm
*.db-wal

# dev.db se versiona vía Git LFS (repo privado); WAL/SHM siguen ignorados
!/dev.db

# misc
.DS_Store
*.pem

# large binaries / local data dumps (keep out of git; GitHub rejects >100MB)
*.zip
/tmp_inspect_pages/

# python build artifacts (ingest_service)
__pycache__/
*.pyc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# User uploads (dev only)
public/uploads/
