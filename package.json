  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "quality": "npm run prisma:validate && npm run prisma:generate && npm run lint && npm run typecheck && npm run qa:p0 && npm run qa:authz && npm run qa:edge && npm run qa:practice-area && npm run qa:ui && npm run build",
    "qa:p0": "node scripts/verify-p0.mjs",
    "qa:authz": "node scripts/verify-authz.mjs",
    "qa:edge": "node scripts/verify-edge-cases.mjs",
    "qa:ui": "node scripts/verify-ui-consistency.mjs",
    "qa:practice-area": "node scripts/verify-practice-area.mjs",
    "qa:assignment-integrity": "node scripts/verify-assignment-integrity.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "tsx prisma/seed.prod.ts",
    "db:init:prod": "node scripts/init-prod-db.mjs",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "db:patch": "node scripts/apply-data-patches.mjs",
