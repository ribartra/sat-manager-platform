generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String?
  role         String    @default("STUDENT") // STUDENT | TEACHER | ADMIN
  startDate    DateTime?
  avatarUrl    String?
  birthDate    DateTime?
  active       Boolean   @default(true)
  validationStatus       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  validationReviewedAt   DateTime?
  validationReviewedById String?
  lastActiveAt DateTime?
  termsAcceptedAt DateTime? // when the user accepted the Terms of Use (activation)
  termsVersion String?      // TERMS_VERSION accepted (lib/consent.ts)
  /// Bumped on password change/reset and anonymization; JWTs carrying an older value are rejected.
  sessionVersion Int     @default(0)
  /// Master teacher: may manage teachers (Teachers menu: invite, deactivate, see each teacher's students). Only for the SAT Teacher account.
  canManageTeachers Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  groups      GroupMembership[]
  assignments Assignment[]
  attempts    Attempt[]
  resetTokens    PasswordResetToken[]
  auditLogs   AuditLog[]
  issueReports IssueReport[] @relation("IssueReportAuthor")
  issueReportsResolved IssueReport[] @relation("IssueReportResolver")
  parentLinks ParentStudent[] @relation("ParentLinks")
  childLinks  ParentStudent[] @relation("ChildLinks")
  parentPromptsDismissed ParentLinkPromptDismissal[] @relation("ParentPromptDismisser")
  parentPromptDismissals ParentLinkPromptDismissal[] @relation("ParentPromptStudent")
  notifications Notification[]
  fullTestAssignments FullPracticeTestAssignment[]
  fullTestAttempts FullPracticeTestAttempt[]
  programTeachingAssignments ProgramTeacher[]
  programEnrollments ProgramEnrollment[] @relation("EnrollmentStudent")
  /// Enrollments this teacher owns (students they invited): a teacher sees and manages only these.
  ownedEnrollments ProgramEnrollment[] @relation("EnrollmentOwner")
  parentAccessTokensCreated ParentAccessToken[] @relation("ParentAccessCreatedBy")
  parentAccessTokensForStudent ParentAccessToken[] @relation("ParentAccessStudent")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Program {
  id        String    @id @default(cuid())
  name      String
  startDate DateTime  @default(now())
  endDate   DateTime?
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teachers    ProgramTeacher[]
  enrollments ProgramEnrollment[]
  invites     InviteToken[]
  // The program is the tenant: its bank (questions, sets, Tests, materials) is shared by its teachers.
  questions    Question[]
  practiceSets PracticeSet[]
  fullTests    FullPracticeTest[]
  materials    StudyMaterial[]
}

model ProgramTeacher {
  programId String
  teacherId String
  startDate DateTime  @default(now())
  endDate   DateTime?

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([programId, teacherId])
}

model ProgramEnrollment {
  programId  String
  studentId  String
  enrolledAt DateTime @default(now())
  status     String   @default("APPROVED") // PENDING | APPROVED | REJECTED
  active     Boolean  @default(true)
  parentApprovalStatus  String?    // null = not required | PENDING | APPROVED | REJECTED
  parentApprovedAt      DateTime?
  /// Owner teacher (who invited the student). Within a shared program each teacher sees only their students.
  teacherId             String?

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  student User    @relation("EnrollmentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  teacher User?   @relation("EnrollmentOwner", fields: [teacherId], references: [id], onDelete: SetNull)

  @@id([programId, studentId])
  @@index([teacherId])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  schedule  String?
  createdAt DateTime @default(now())
  members   GroupMembership[]
  assignments GroupAssignment[]
}

model GroupMembership {
  userId  String
  groupId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([userId, groupId])
}

model GroupAssignment {
  groupId       String
  practiceSetId String
  assignedById  String?
  dueDate       DateTime?
  unlockAt      DateTime?
  locked        Boolean  @default(false)
  /// Explanations in the player for the members (copied to each member's Assignment).
  showExplanations Boolean @default(true)
  createdAt     DateTime @default(now())

  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  practiceSet PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)

  @@id([groupId, practiceSetId])
}

/// Practice Exercises area (Math / Reading / Writing). Distinct from mock sections RW|MATH.
enum PracticeArea {
  MATH
  READING
  WRITING
}

/// Official sections. Practice: MATH, READING, WRITING. READING_WRITING holds only the Test
/// placeholder domain (Tests have 2 sections). Labels: Math, Reading, Writing, Reading & Writing.
model Section {
  id      String   @id @default(cuid())
  name    String   @unique
  label   String
  domains Domain[]
}

model Domain {
  id           String        @id @default(cuid())
  name         String
  sectionId    String
  /// Copy of the Section name (MATH | READING | WRITING), kept equal by database triggers
  /// (migration 20261018_practice_sections). Null only for Test placeholders (Full Practice Test).
  practiceArea PracticeArea?
  section      Section       @relation(fields: [sectionId], references: [id])
  topics       Topic[]
  aliases      TaxonomyAlias[]

  @@index([practiceArea])
}

model Topic {
  id        String   @id @default(cuid())
  name      String
  domainId  String
  taxonomyNodeId String?
  domain    Domain   @relation(fields: [domainId], references: [id])
  taxonomyNode TaxonomyNode? @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  subskills Subskill[]
  questions Question[]
  practiceSets PracticeSet[]
  materials StudyMaterial[]
  aliases   TaxonomyAlias[]

  @@index([taxonomyNodeId])
}

/// Domain ↔ Skill correspondence aliases (lib/taxonomy-reference.ts ← Taxonomia-SAT.md + PDFs): other
/// names a domain or skill is printed with (PDF), the source folder name in files_to_load (FILE), a name
/// it had before (LEGACY), or one added by an admin (MANUAL).
/// The platform always shows Domain.name / Topic.name; aliases are used to match ingest files.
model TaxonomyAlias {
  id        String   @id @default(cuid())
  alias     String
  kind      String   // DOMAIN | SKILL
  domainId  String
  topicId   String?  // set for SKILL aliases
  source    String   @default("MANUAL") // PDF | FILE | LEGACY | MANUAL
  createdAt DateTime @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  topic  Topic? @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([kind, alias])
  @@index([domainId])
  @@index([topicId])
}

model Subskill {
  id      String @id @default(cuid())
  name    String
  topicId String
  taxonomyNodeId String?
  topic   Topic  @relation(fields: [topicId], references: [id])
  taxonomyNode TaxonomyNode? @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  questions Question[]

  @@index([taxonomyNodeId])
}

model TaxonomyNode {
  id        String   @id @default(cuid())
  name      String
  label     String
  type      String   // AREA | DOMAIN | SKILL | SUBSKILL
  parentId  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    TaxonomyNode?  @relation("TaxonomyTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  TaxonomyNode[] @relation("TaxonomyTree")
  topics    Topic[]
  subskills Subskill[]

  @@index([parentId])
  @@index([type])
  @@unique([parentId, type, name])
}

model Question {
  id            String   @id @default(cuid())
  stem          String
  stimulus      String?
  type          String   @default("MC") // MC | NUMERIC
  difficulty    String   @default("EASY") // EASY | MEDIUM | HARD
  correctAnswer String
  explanation   String?
  topicId       String
  subskillId    String?
  status        String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  imageUrl      String?
  supportsGraph Boolean  @default(false)
  /// Tenant: the program whose bank holds this question.
  programId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  program  Program?  @relation(fields: [programId], references: [id], onDelete: Restrict)
  topic    Topic     @relation(fields: [topicId], references: [id])
  subskill Subskill? @relation(fields: [subskillId], references: [id])
  options  QuestionOption[]
  setItems PracticeSetQuestion[]
  answers  AttemptAnswer[]
  fullTestItems FullPracticeTestQuestion[]
  @@index([topicId, difficulty, status])
  @@index([createdAt])
  @@index([programId])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  label      String   // A | B | C | D
  text       String
  imageUrl   String?
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model PracticeSet {
  id                    String   @id @default(cuid())
  name                  String
  topicId               String
  difficulty            String   @default("EASY")
  status                String   @default("DRAFT") // DRAFT | PUBLISHED | BLOCKED | ARCHIVED
  explanationVisibility String   @default("HIDDEN") // IMMEDIATE | AFTER_FINISH | HIDDEN
  /// Tenant: the program whose bank holds this set.
  programId             String?
  /// Where the content comes from (College Board, …).
  sourceId              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  program     Program?            @relation(fields: [programId], references: [id], onDelete: Restrict)
  source      Source?             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  topic       Topic               @relation(fields: [topicId], references: [id])
  questions   PracticeSetQuestion[]
  assignments Assignment[]
  groupAssignments GroupAssignment[]

  @@index([programId])
  @@index([sourceId])
}

/// Where Practice Sets and Tests come from (College Board, Innovator, …). Global, managed by admins.
model Source {
  id                String             @id @default(cuid())
  name              String             @unique
  active            Boolean            @default(true)
  sortOrder         Int                @default(0)
  /// Offered in the Practice Set editor / Practice › By skill (Innovator is Tests-only).
  forPracticeSets   Boolean            @default(true)
  /// Offered in the Test editor.
  forTests          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  practiceSets      PracticeSet[]
  fullPracticeTests FullPracticeTest[]
}

model PracticeSetQuestion {
  practiceSetId String
  questionId    String
  order         Int
  practiceSet   PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id])
  @@id([practiceSetId, questionId])
}

model Assignment {
  id            String    @id @default(cuid())
  practiceSetId String
  studentId     String
  assignedById  String?
  dueDate       DateTime?
  unlockAt      DateTime?
  locked        Boolean   @default(false)
  status        String    @default("PENDING")
  /// Per-assignment practice feedback: IMMEDIATE (Check per question) | AFTER_SET (only after submit).
  feedbackMode  String    @default("AFTER_SET")
  /// Per-student choice: explanations are shown in the player (after Check). Default on.
  showExplanations Boolean @default(true)
  createdAt     DateTime  @default(now())

  practiceSet PracticeSet @relation(fields: [practiceSetId], references: [id])
  student     User        @relation(fields: [studentId], references: [id])
  attempts    Attempt[]
  unlockRequests UnlockRequest[]

  @@unique([studentId, practiceSetId])
  @@index([status, dueDate])
  @@index([locked, unlockAt])
}

/// Partial unique indexes (raw migration 20261005_single_open_attempt): at most one IN_PROGRESS attempt
/// per assignment, and per student+set when unassigned. Keep them when generating new migrations.
model Attempt {
  id              String    @id @default(cuid())
  assignmentId    String?
  studentId       String
  practiceSetId   String
  practiceSetSnapshot String?
  attemptNumber   Int       @default(1)
  startedAt       DateTime  @default(now())
  submittedAt     DateTime?
  totalTime       Int?
  status          String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | INVALIDATED
  /// The assignment's "Show explanations in the player" when this attempt was taken.
  showExplanations Boolean?
  currentQuestion Int       @default(0)
  teacherComment  String?
  /// Percent correct 0–100 at submit (also drives the 75% unlock rule).
  scorePercent    Int?
  /// Estimated SAT section score 200–800 (Practice Set → section curve).
  scaledScore     Int?
  /// RW | MATH — section used for scaledScore.
  scoreSection    String?

  assignment Assignment? @relation(fields: [assignmentId], references: [id])
  student    User        @relation(fields: [studentId], references: [id])
  answers    AttemptAnswer[]
  pauses     AttemptPause[]
  @@index([studentId, status])
  @@index([assignmentId])
  @@index([practiceSetId])
}

model AttemptPause {
  id              String    @id @default(cuid())
  attemptId       String
  pausedAt        DateTime  @default(now())
  resumedAt       DateTime?
  durationSeconds Int?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
}

model AttemptAnswer {
  id              String  @id @default(cuid())
  attemptId       String
  questionId      String
  questionSnapshot String?
  answer          String?
  isCorrect       Boolean?
  timeSpent       Int?
  markedForReview Boolean @default(false)
  note            String?
  eliminatedOptions String?
  /// Set when the student used "Check" (immediate feedback); the answer can no longer change.
  checkedAt       DateTime?

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  question Question @relation(fields: [questionId], references: [id])
  @@unique([attemptId, questionId])
  @@index([questionId])
}

model InviteToken {
  id        String    @id @default(cuid())
  role      String    @default("STUDENT") // STUDENT | PARENT
  email     String
  name      String
  phone     String?
  startDate DateTime?
  invitedById String?
  programId String?
  isMinor   Boolean   @default(false)
  birthDate DateTime? // when set, isMinor is derived from it (lib/consent.ts)
  parentConsentRequired Boolean @default(false) // teacher asked for parent authorization (always true for minors)
  parentName String?
  parentEmail String?
  parentPhone String?
  linkedStudentEmail String? // parent token: student email to link after activation
  parentConsentToken String? @unique
  parentConsentTokenHash String? @unique
  parentConsentAt DateTime?
  parentConsentIp String?
  parentConsentVersion String? // PARENT_CONSENT_VERSION the parent accepted
  token     String    @unique
  tokenHash String?   @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime? // cancelled: the link no longer works and a new invitation may be sent
  termsAcceptedAt DateTime?
  termsVersion String?
  program   Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  tokenHash String?   @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  @@index([createdAt])
  @@index([targetId])
}

/// "Report a problem" (components/sat/issue-reporter.tsx): a user points at part of a screen and
/// comments. Saved here and emailed to ISSUE_REPORT_EMAIL; listed in Admin → Reports.
model IssueReport {
  id             String    @id @default(cuid())
  userId         String
  role           String
  category       String // PROBLEM | CONFUSING | SUGGESTION | PRAISE
  comment        String
  url            String
  pageTitle      String?
  viewport       String?
  userAgent      String?
  target         String // JSON: selected element(s), page context, JS errors
  screenshot     Bytes?
  screenshotType String?
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  emailSentAt    DateTime?
  emailError     String?
  resolvedById   String?
  resolvedAt     DateTime?
  /// Who fixed it: ADMIN (Admin → Reports) or AGENT (coding agent via /api/agent/issue-reports/[id]).
  resolvedBySource String?
  resolutionNote String?
  /// Commit / PR / ticket link given with the fix.
  resolutionRef  String?
  /// Coding agent (lib/coder-agent-settings.ts): its ticket id and the last send.
  agentTicketId  String?
  agentSentAt    DateTime?
  agentError     String?
  createdAt      DateTime  @default(now())
  user           User      @relation("IssueReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy     User?     @relation("IssueReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  events         IssueReportEvent[]
  @@index([status, createdAt])
  @@index([userId])
}

/// Timeline of an IssueReport: emails, coding agent sends/updates, admin resolve/reopen.
model IssueReportEvent {
  id        String      @id @default(cuid())
  reportId  String
  source    String // ADMIN | AGENT | SYSTEM
  type      String // CREATED | EMAILED | EMAIL_FAILED | SENT_TO_AGENT | AGENT_ERROR | IN_PROGRESS | RESOLVED | REOPENED | NOTE
  message   String?
  ref       String?
  userId    String?
  createdAt DateTime    @default(now())
  report    IssueReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  @@index([reportId, createdAt])
}

model UnlockRequest {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  status       String    @default("PENDING") // PENDING | APPROVED | DENIED
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
}

model ParentStudent {
  parentId  String
  studentId String
  authorizedAt DateTime?
  parent    User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Restrict)
  student   User @relation("ChildLinks", fields: [studentId], references: [id], onDelete: Restrict)

  @@id([parentId, studentId])
}

/// A teacher chose "Don't ask again" for linking a parent to this student (report → email to an address).
model ParentLinkPromptDismissal {
  userId    String
  studentId String
  createdAt DateTime @default(now())
  user      User     @relation("ParentPromptDismisser", fields: [userId], references: [id], onDelete: Cascade)
  student   User     @relation("ParentPromptStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([userId, studentId])
  @@index([studentId])
}

model ParentAccessToken {
  id          String    @id @default(cuid())
  studentId   String
  createdById String
  parentId    String?   // associated parent the report link was shared with
  areas       String?   // CSV of report areas included: mathematics,reading,writing
  tokenHash   String    @unique
  expiresAt   DateTime  // activation deadline: link must be opened before this
  usedAt      DateTime? // first-open timestamp; the 7-day access window starts here
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  student   User @relation("ParentAccessStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User @relation("ParentAccessCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
}

model FullPracticeTest {
  id             String   @id @default(cuid())
  name           String
  /// "TEST N": groups the versions of one test across sources.
  number         Int?
  status         String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  reviewEnabled  Boolean  @default(true)
  /// Break between RW Module 2 and Math Module 1 (minutes). 0 = no break.
  breakMinutes   Int      @default(0)
  /// Tenant: the program whose bank holds this Test.
  programId      String?
  /// Where the content comes from (Innovator, …).
  sourceId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  program        Program? @relation(fields: [programId], references: [id], onDelete: Restrict)
  source         Source?  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  modules        FullPracticeTestModule[]
  assignments    FullPracticeTestAssignment[]
  attempts       FullPracticeTestAttempt[]

  @@index([programId])
  @@index([sourceId])
  @@index([number])
}

model FullPracticeTestModule {
  id        String @id @default(cuid())
  testId    String
  name      String
  section   String // RW | MATH
  order     Int
  timeLimit Int
  test      FullPracticeTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions FullPracticeTestQuestion[]
}

model FullPracticeTestQuestion {
  moduleId   String
  questionId String
  order      Int
  /// First two questions per module (order 0,1) are pretest and do not count toward raw score.
  isPretest  Boolean @default(false)
  module     FullPracticeTestModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  question   Question               @relation(fields: [questionId], references: [id])

  @@id([moduleId, questionId])
}

model FullPracticeTestAssignment {
  id          String    @id @default(cuid())
  testId      String
  studentId   String
  assignedById String?
  dueDate     DateTime?
  /// Open date: the student can start the Test from this moment (null = right away).
  unlockAt    DateTime?
  status      String    @default("PENDING")
  /// When to show answers: IMMEDIATE (Check per question in the player) | AFTER_SET (only in the results).
  feedbackMode String   @default("AFTER_SET")
  /// Per-student choice: the explanation with each checked answer in the Test player (IMMEDIATE only).
  /// The assign form starts it off and always sends it (the column default stays: no table rebuild).
  showExplanations Boolean @default(true)
  createdAt   DateTime  @default(now())
  test        FullPracticeTest @relation(fields: [testId], references: [id])
  student     User             @relation(fields: [studentId], references: [id])
  attempts    FullPracticeTestAttempt[]

  @@unique([studentId, testId])
  @@index([status, dueDate])
}

/// Partial unique index (raw migration 20261005_single_open_attempt): at most one IN_PROGRESS attempt
/// per assignment. Keep it when generating new migrations.
model FullPracticeTestAttempt {
  id             String    @id @default(cuid())
  testId         String
  assignmentId   String?
  studentId      String
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  status         String    @default("IN_PROGRESS")
  /// The assignment's "Show explanations in the player" when this attempt was taken.
  showExplanations Boolean?
  currentModule  Int       @default(0)
  currentQuestion Int      @default(0)
  moduleTimerState String?
  rwScore        Int?
  mathScore      Int?
  totalScore     Int?
  timeExpiredEvents Int    @default(0)
  extraTimeUsed  Int       @default(0)
  // Immutable copy of modules/questions/keys taken when the attempt starts (lib/attempt-snapshots.ts):
  // grading and results read it, so later edits to the exam or its questions never change history.
  testSnapshot   String?
  test           FullPracticeTest @relation(fields: [testId], references: [id])
  assignment     FullPracticeTestAssignment? @relation(fields: [assignmentId], references: [id])
  student        User @relation(fields: [studentId], references: [id])
  answers        FullPracticeTestAnswer[]
  pauses         FullPracticeTestPause[]
  @@index([studentId, status])
  @@index([assignmentId])
  @@index([testId])
}

model FullPracticeTestPause {
  id              String    @id @default(cuid())
  attemptId       String
  pausedAt        DateTime  @default(now())
  resumedAt       DateTime?
  durationSeconds Int?

  attempt FullPracticeTestAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
}

model FullPracticeTestAnswer {
  id              String @id @default(cuid())
  attemptId       String
  moduleId        String
  questionId      String
  answer          String?
  isCorrect       Boolean?
  timeSpent       Int?
  markedForReview Boolean @default(false)
  note            String?
  eliminatedOptions String?
  /// Set when the student used Check (answer locked from then on).
  checkedAt       DateTime?
  attempt         FullPracticeTestAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model FullPracticeTestScoreConversion {
  id        String @id @default(cuid())
  section   String // RW | MATH
  rawCorrect Int
  score     Int

  @@unique([section, rawCorrect])
}

model StudyMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  body        String?
  url         String?
  topicId     String?
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  createdById String?
  /// Tenant: the program whose bank holds this material.
  programId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program Program? @relation(fields: [programId], references: [id], onDelete: Restrict)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([programId])
}

model IngestBatch {
  id                 String   @id
  name               String
  basePath           String
  status             String   @default("PENDING") // PENDING | SCANNING | PROCESSING | COMPLETED | FAILED
  totalFiles         Int      @default(0)
  totalPages         Int      @default(0)
  filesProcessed     Int      @default(0)
  pagesProcessed     Int      @default(0)
  candidatesDetected Int      @default(0)
  errorCount         Int      @default(0)
  lastError          String?
  /// Content Source given to what this batch promotes (null = College Board / Innovator default).
  sourceId           String?
  /// null = OCR pipeline; "AI_CSV" = simple import (CSV made by an external AI from the PDF).
  importMode         String?
  /// Simple import target: { kind, topicId?, difficulty?, testName? }.
  targetJson         String?
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model IngestSourceFile {
  id           String   @id
  batchId      String
  path         String
  relativePath String
  hash         String
  extension    String
  contentType  String   @default("UNKNOWN") // FULL_PRACTICE_TEST | PRACTICE_SET | UNKNOWN
  sourceKind   String   @default("UNKNOWN") // MOCK_EXAM | PRACTICE_EXERCISE | ANSWER_KEY | ANSWER_EXPLANATION | UNKNOWN
  section      String?
  domainName   String?
  topicName    String?
  difficulty   String?
  difficultySource String?
  practiceSetVariant String?
  testNumber   Int?
  isAnswerFile Boolean  @default(false)
  isExplanationFile Boolean @default(false)
  isQuestionSource Boolean @default(true)
  metadataWarningsJson String?
  status       String   @default("PENDING")
  pageCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([batchId])
  @@index([hash])
}

model IngestPageArtifact {
  id             String   @id
  batchId        String
  sourceFileId   String
  pageNumber     Int
  method         String   @default("UNPROCESSED") // PDF_TEXT | DOCX_TEXT | MISTRAL_OCR | OCR_REQUIRED | FAILED
  textDensity    Float    @default(0)
  extractedText  String?
  layoutJson     String?
  contentHash    String?
  requiresOcr    Boolean  @default(false)
  status         String   @default("PENDING")
  warning        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceFileId, pageNumber])
  @@index([batchId])
  @@index([contentHash])
}

model IngestImageArtifact {
  id             String   @id
  batchId        String
  sourceFileId   String
  pageArtifactId String?
  pageNumber     Int
  imageIndex     Int
  imageId        String?
  origin         String   @default("PDFPLUMBER") // PDFPLUMBER | MISTRAL_OCR
  bboxJson       String?
  mimeType       String?
  base64Data     String?
  fileUrl        String?
  width          Int?
  height         Int?
  contentHash    String?
  status         String   @default("AVAILABLE")
  createdAt      DateTime @default(now())

  @@unique([sourceFileId, pageNumber, imageIndex, origin])
  @@index([batchId])
  @@index([sourceFileId])
  @@index([pageArtifactId])
  @@index([contentHash])
}

model IngestOcrCache {
  id           String   @id
  contentHash  String
  model        String
  responseJson String
  text         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([contentHash, model])
}

model IngestQuestionCandidate {
  id             String   @id
  batchId        String
  sourceFileId   String
  pageArtifactId String?
  questionNumber Int?
  questionExternalId String?
  testNumber     Int?
  moduleLabel    String?
  sourceLabel    String?
  contentType    String?
  section        String?
  domainName     String?
  topicName      String?
  subskillName   String?
  difficulty     String?
  difficultySource String?
  practiceSetVariant String?
  type           String   @default("MC")
  stem           String?
  stimulus       String?
  optionsJson    String?
  correctAnswer  String?
  explanation    String?
  answerSource   String?
  rawJson        String
  confidence     Float    @default(0)
  warningsJson   String?
  status         String   @default("NEEDS_REVIEW") // NEEDS_REVIEW | READY | REVIEWED | REJECTED
  officialQuestionId String?
  promotionStatus String @default("NOT_PROMOTED") // NOT_PROMOTED | EDITING | PROMOTED | REJECTED
  promotedAt     DateTime?
  promotedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([batchId])
  @@index([sourceFileId])
  @@index([status])
  @@index([officialQuestionId])
  @@index([promotionStatus])
}

model IngestCandidateImageLink {
  id              String   @id
  batchId         String
  candidateId     String
  imageArtifactId String
  targetType      String   @default("STEM") // STEM | STIMULUS | OPTION | OPTION_BLOCK | ANSWER_FIELD | EXPLANATION | PAGE_CONTEXT
  optionLabel     String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([candidateId, imageArtifactId, targetType, optionLabel])
  @@index([batchId])
  @@index([candidateId])
  @@index([imageArtifactId])
}

model IngestReviewSession {
  id              String   @id
  batchId         String
  sourceFileId    String?
  currentStep     String   @default("FILES") // FILES | PAGES | QUESTIONS | ANSWERS | IMAGES | FINAL
  status          String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  progressJson    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([batchId])
  @@index([sourceFileId])
}

model IngestJobEvent {
  id                      String   @id
  batchId                 String
  sourceFileId            String?
  pageArtifactId          String?
  jobType                 String   @default("PROCESS") // PROCESS | RETRY_OCR | REPAIR
  status                  String   @default("RUNNING") // STARTED | RUNNING | COMPLETED | FAILED
  message                 String
  processedFiles          Int      @default(0)
  processedPages          Int      @default(0)
  totalFilesKnown         Int      @default(0)
  totalPagesKnown         Int      @default(0)
  estimatedRemainingPages Float    @default(0)
  estimatedSecondsRemaining Int    @default(0)
  secondsPerPage          Float    @default(60)
  avgPagesPerFile         Float    @default(0)
  metadataJson            String?
  createdAt               DateTime @default(now())

  @@index([batchId])
  @@index([sourceFileId])
  @@index([jobType])
  @@index([status])
}

model IngestPromotionArtifact {
  id           String   @id
  batchId      String
  sourceFileId String?
  artifactType String // QUESTION | PRACTICE_SET | FULL_PRACTICE_TEST
  artifactId   String
  groupKey     String
  createdById  String?
  createdAt    DateTime @default(now())

  @@unique([batchId, artifactType, groupKey])
  @@index([batchId])
  @@index([sourceFileId])
  @@index([artifactType])
  @@index([artifactId])
}

model IngestAnswerCandidate {
  id             String   @id
  batchId        String
  sourceFileId   String
  pageArtifactId String?
  questionNumber Int?
  questionExternalId String?
  testNumber     Int?
  section        String?
  moduleLabel    String?
  answer         String?
  explanation    String?
  rawText        String?
  confidence     Float    @default(0)
  createdAt      DateTime @default(now())

  @@index([batchId])
  @@index([sourceFileId])
}

model IngestIncident {
  id             String   @id
  batchId        String
  sourceFileId   String?
  pageArtifactId String?
  severity       String   @default("WARNING") // INFO | WARNING | ERROR
  code           String
  message        String
  decision       String?
  action         String?
  status         String   @default("OPEN") // OPEN | RESOLVED
  contextHash    String   @unique
  createdAt      DateTime @default(now())

  @@index([batchId])
  @@index([severity])
}
