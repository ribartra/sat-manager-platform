DATABASE_URL="file:./dev.db"
AI_INGEST_SERVICE_URL="http://localhost:8000"
MISTRAL_API_KEY=""
MISTRAL_OCR_MODEL="mistral-ocr-latest"
MISTRAL_STRUCTURING_MODEL="mistral-large-latest"
AUTH_SECRET="replace-with-a-random-secret"
SECRET_ENCRYPTION_KEY="replace-with-a-separate-random-32-byte-secret"
INTERNAL_INGEST_TOKEN="replace-with-a-random-service-to-service-token"
AUTH_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Email flows via SMTP: invitations, parent consent, password reset, shared parent reports.
# These EMAIL_* vars are the fallback; SMTP can also be configured from Admin -> Settings
# (stored in the DB, password encrypted), and DB values override these env vars per field.
# EMAIL_FROM must be a sender verified with your SMTP provider (e.g. Brevo).
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_HOST="smtp-relay.brevo.com"
EMAIL_PORT="587"
EMAIL_USER="your-brevo-smtp-login"
EMAIL_PASS="your-brevo-smtp-key"

# Local SQLite backup destination.
BACKUP_DIR="./backups"

# Math calculator provider for Math Practice Sets and Full Practice Tests.
# Options: desmos_sat, desmos_api, geogebra, geogebra_api, local_2d, local_3d, none.
NEXT_PUBLIC_CALCULATOR_PROVIDER="desmos_sat"
NEXT_PUBLIC_CALCULATOR_PRACTICE_SETS="true"
NEXT_PUBLIC_CALCULATOR_FULL_TESTS="true"
NEXT_PUBLIC_DESMOS_API_KEY=""
NEXT_PUBLIC_DESMOS_API_URL="https://www.desmos.com/api/v1.12/calculator.js"
NEXT_PUBLIC_DESMOS_SAT_URL="https://www.desmos.com/testing/sat/calculator"
NEXT_PUBLIC_GEOGEBRA_URL="https://www.geogebra.org/calculator"
NEXT_PUBLIC_GEOGEBRA_DEPLOY_URL="https://www.geogebra.org/apps/deployggb.js"
NEXT_PUBLIC_GEOGEBRA_APP_NAME="graphing"
