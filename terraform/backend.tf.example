# Remote Terraform state on GCS (recommended for anything beyond a throwaway).
# Keeping state remote + versioned + IAM-restricted protects it and enables
# team/CI use. Copy to backend.tf and create the bucket first:
#
#   gsutil mb -l us-central1 -b on gs://<project>-sat-tfstate
#   gsutil versioning set on gs://<project>-sat-tfstate
#
# Then `terraform init -migrate-state`.
#
# terraform {
#   backend "gcs" {
#     bucket = "<project>-sat-tfstate"
#     prefix = "prod"
#   }
# }
