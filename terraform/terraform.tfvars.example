# Copy to terraform.tfvars and fill in. Do NOT commit terraform.tfvars.
#
# NOTE: no secret VALUES live here anymore — they would end up in Terraform
# state in plaintext. Terraform only creates empty Secret Manager containers;
# load the values after `terraform apply` with deploy/load-secrets.sh.
project_id = "my-gcp-project"
region     = "us-central1"
zone       = "us-central1-a"
domain     = "sat.example.com"

# Sizing (defaults are the recommended production values).
#   machine_type: e2-medium (4 GB) recommended; e2-small only for a light demo.
#   data_disk_gb: 50 recommended; 20 only if images/staging stay small.
machine_type = "e2-medium"
data_disk_gb = 50

# Image tag to run. Prefer an immutable git-sha tag over "latest" for
# reproducible rollbacks (build & push it first with deploy/build-and-push.sh).
image_tag = "latest"

# SMTP relay (non-secret parts). The password is a secret — load it with
# deploy/load-secrets.sh, not here.
email_from = "noreply@example.com"
email_host = "smtp-relay.brevo.com"
email_port = 587
email_user = "your-brevo-login"
